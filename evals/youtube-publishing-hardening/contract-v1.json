    {"id": "YT-HARD-04", "name": "unmanaged playlist replacement fails closed", "expect": ["existing_unmanaged_resource", "deny_destructive_replace"]},
    {"id": "YT-HARD-05", "name": "caption lifecycle", "expect": ["insert", "list_readback", "download_vtt", "update", "delete", "restore_original_state"]},
    {"id": "YT-HARD-06", "name": "banner invalid source diagnostics", "expect": ["stage_upload", "vendor_error_bounded", "no_secret_material"]},
    {"id": "YT-HARD-07", "name": "banner valid upload apply readback", "expect": ["valid_media", "upload", "apply", "branding_readback", "recoverable_full_resolution_source"]},
    {"id": "YT-HARD-08", "name": "watermark unmanaged-state protection", "expect": ["no_reliable_read_baseline", "fail_closed", "explicit_creator_authority_override"]},
    {"id": "YT-HARD-09", "name": "mutation audit diagnostic safety", "expect": ["stage", "error_code", "google_status", "google_reason", "google_message", "google_location", "google_location_type", "bounded_vendor_json", "no_tokens_or_secrets"]}
