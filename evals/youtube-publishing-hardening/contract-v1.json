{
  "version": 1,
  "skill": "youtube-publishing",
  "purpose": "Contract coverage for production YouTube mutation hardening, fail-closed recovery semantics, and risk-tiered viewer-comment engagement.",
  "cases": [
    {
      "id": "YT-HARD-01",
      "name": "playlist image first insert",
      "expect": [
        "exact_ownership",
        "single_insert",
        "readback",
        "managed_state_after_verification"
      ]
    },
    {
      "id": "YT-HARD-02",
      "name": "playlist image managed replacement",
      "expect": [
        "managed_baseline_required",
        "delete_then_insert",
        "readback",
        "persist_new_baseline"
      ]
    },
    {
      "id": "YT-HARD-03",
      "name": "playlist image replacement rollback",
      "expect": [
        "insert_failure",
        "rollback_previous_managed_source",
        "truthful_partial_state_if_rollback_fails"
      ]
    },
    {
      "id": "YT-HARD-04",
      "name": "unmanaged playlist replacement fails closed",
      "expect": [
        "existing_unmanaged_resource",
        "deny_destructive_replace"
      ]
    },
    {
      "id": "YT-HARD-05",
      "name": "caption lifecycle",
      "expect": [
        "insert",
        "list_readback",
        "download_vtt",
        "update",
        "delete",
        "restore_original_state"
      ]
    },
    {
      "id": "YT-HARD-06",
      "name": "banner invalid source diagnostics",
      "expect": [
        "stage_upload",
        "vendor_error_bounded",
        "no_secret_material"
      ]
    },
    {
      "id": "YT-HARD-07",
      "name": "banner valid upload apply readback",
      "expect": [
        "valid_media",
        "upload",
        "apply",
        "branding_readback",
        "recoverable_full_resolution_source"
      ]
    },
    {
      "id": "YT-HARD-08",
      "name": "watermark unmanaged-state protection",
      "expect": [
        "no_reliable_read_baseline",
        "fail_closed",
        "explicit_creator_authority_override"
      ]
    },
    {
      "id": "YT-HARD-09",
      "name": "mutation audit diagnostic safety",
      "expect": [
        "stage",
        "error_code",
        "google_status",
        "google_reason",
        "google_message",
        "google_location",
        "google_location_type",
        "bounded_vendor_json",
        "no_tokens_or_secrets"
      ]
    },
    {
      "id": "upload-submit-auto-runner-contract",
      "name": "upload submit auto runner contract",
      "expect": [
        "MCP exposes youtube_upload_submit",
        "submit maps to POST /v1/upload-jobs",
        "youtube_upload_create remains available"
      ]
    },
    {
      "id": "runner-queue-discovery-contract",
      "name": "runner queue discovery contract",
      "expect": [
        "Gateway exposes runner-authenticated GET /v1/upload-jobs/next",
        "queue discovery returns source locator only through runnerJob",
        "persistent daemon polls queue and invokes uploader by job id"
      ]
    },
    {
      "id": "eventual-consistency-upload-verification",
      "name": "eventual consistency upload verification",
      "expect": [
        "video verification uses bounded retries",
        "playlist insert read-back uses bounded retries",
        "playlist read-back lag can produce inserted_pending_readback without failing the upload"
      ]
    },
    {
      "id": "YT-HARD-10",
      "name": "positive comment autonomous friendly reply",
      "expect": [
        "positive_low_risk",
        "concise_friendly_reply",
        "autonomous_when_channel_voice_clear",
        "readback_after_write"
      ]
    },
    {
      "id": "YT-HARD-11",
      "name": "sensitive or contested comment neutral handling",
      "expect": [
        "sensitive_or_contested",
        "neutral_factual_tone",
        "documented_fact_with_uncertainty",
        "creator_review_when_materially_escalatory",
        "no_personal_speculation"
      ]
    },
    {
      "id": "YT-HARD-12",
      "name": "disagreement is not destructive moderation",
      "expect": [
        "skepticism_or_disagreement",
        "reply_or_no_action_before_moderation",
        "destructive_moderation_requires_explicit_authority"
      ]
    },
    {
      "id": "YT-HARD-13",
      "name": "new publication requires SEO launch package including Shorts",
      "expect": [
        "new_upload_or_short",
        "youtube_publishing_primary",
        "youtube_seo_supporting_when_package_unlocked",
        "content_truth_and_discovery_surface",
        "title_description_minimal_tags_playlist_thumbnail_promise",
        "no_transport_time_metadata_invention"
      ]
    }
  ],
  "negative_claims": [
    "tool exposure alone does not prove a live gate",
    "playlistImages.update is not assumed production-safe",
    "bannerExternalUrl alone is not rollback state",
    "watermark set/unset exposure is not a fully verified lifecycle",
    "an accepted mutation request is not success without readback when readable state exists",
    "a Short is not exempt from launch-package research merely because Shorts-feed discovery differs from long-form search"
  ]
}
