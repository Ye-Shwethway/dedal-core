{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEDAL Motion Shot Spec",
  "type": "object",
  "required": [
    "shot_id",
    "narrative_function",
    "start_state",
    "temporal_change",
    "end_state",
    "acceptance_checks"
  ],
  "properties": {
    "shot_id": {
      "type": "string"
    },
    "narrative_function": {
      "type": "string"
    },
    "duration_target": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "start_state": {
      "type": "object"
    },
    "temporal_change": {
      "type": "object"
    },
    "end_state": {
      "type": "object"
    },
    "performance": {
      "type": "object"
    },
    "subject_motion": {
      "type": "object"
    },
    "object_motion": {
      "type": "object"
    },
    "environment_motion": {
      "type": "object"
    },
    "camera": {
      "type": "object"
    },
    "audio_intent": {
      "type": "object"
    },
    "reference_roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "continuity_locks": {
      "type": "object"
    },
    "allowed_change": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_requirements": {
      "type": "object"
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ordered_keyframes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pairwise_reachability": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transition_complexity": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "compilation_strategy": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "source_only_plan": {
      "type": "object",
      "required": [
        "stage",
        "pixel_qa_status",
        "pairs"
      ],
      "properties": {
        "stage": {
          "enum": [
            "planned",
            "source_ready",
            "sent",
            "acknowledged"
          ]
        },
        "pixel_qa_status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "unknown"
          ]
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from_asset",
              "to_asset",
              "relation",
              "mechanism",
              "timing_assumptions",
              "camera_relation",
              "decision"
            ],
            "properties": {
              "from_asset": {
                "type": "string",
                "minLength": 1
              },
              "to_asset": {
                "type": "string",
                "minLength": 1
              },
              "from_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "relation": {
                "enum": [
                  "continuous",
                  "cut",
                  "hold",
                  "loop"
                ]
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "timing_assumptions": {
                "type": "string",
                "minLength": 1
              },
              "camera_relation": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "decision": {
                "enum": [
                  "ready",
                  "needs_bridge",
                  "split",
                  "cut",
                  "repair_source",
                  "unresolved"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "known_debt": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "source_ready",
                  "sent",
                  "acknowledged"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "pixel_qa_status": {
                "const": "passed"
              },
              "pairs": {
                "items": {
                  "properties": {
                    "decision": {
                      "enum": [
                        "ready",
                        "cut"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
