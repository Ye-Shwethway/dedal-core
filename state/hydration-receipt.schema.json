{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEDAL session hydration receipt v2",
  "type": "object",
  "required": ["schema_version", "task_id", "profile_id", "source_reads", "gate_checks", "condition_results"],
  "properties": {
    "schema_version": {"const": 2},
    "task_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "source_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "read_ref", "observed_at"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["library_file_read", "library_directory_list"]},
          "read_ref": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "library_file_id": {"type": "string", "pattern": "^libfile_"},
          "version_id": {"type": ["string", "null"]},
          "item_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "gate_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "evidence_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "condition_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["applies", "evidence_ref"],
        "properties": {
          "applies": {"type": "boolean"},
          "evidence_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
