{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEDAL phase hydration receipt v6",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "profile_id",
    "source_reads",
    "gate_checks",
    "condition_results",
    "release_sha256",
    "task_started_at",
    "task_sha256",
    "routing_decision_sha256",
    "operation",
    "phase",
    "evidence_mode",
    "evidence_bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "source_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "read_ref",
          "observed_at",
          "read_class"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "library_file_read",
              "library_directory_list"
            ]
          },
          "read_ref": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "library_file_id": {
            "type": "string",
            "pattern": "^libfile_"
          },
          "version_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_count": {
            "type": "integer",
            "minimum": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version_status": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "read_class": {
            "enum": [
              "boot",
              "discovery",
              "hydration",
              "reused"
            ]
          },
          "activated_at": {
            "type": "string",
            "format": "date-time"
          },
          "reuse_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "library_file_read"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "library_file_id",
                "version_id",
                "version_status",
                "content_sha256"
              ],
              "oneOf": [
                {
                  "properties": {
                    "version_status": {
                      "const": "available"
                    },
                    "version_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "properties": {
                    "version_status": {
                      "const": "unavailable"
                    },
                    "version_id": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "read_class": {
                  "const": "reused"
                }
              },
              "required": [
                "read_class"
              ]
            },
            "then": {
              "required": [
                "activated_at",
                "reuse_reason"
              ]
            }
          }
        ]
      }
    },
    "gate_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence_ref",
          "passed",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "const": true
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "condition_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "applies",
          "evidence_ref",
          "observed_at"
        ],
        "properties": {
          "applies": {
            "type": "boolean"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "routing_decision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "inspect",
        "execute",
        "close"
      ]
    },
    "evidence_mode": {
      "enum": [
        "coverage",
        "local_artifacts"
      ]
    },
    "evidence_bundle_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_mode": {
            "const": "coverage"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_bundle_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_bundle_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
