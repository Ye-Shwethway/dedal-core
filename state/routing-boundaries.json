{
  "schema_version": 3,
  "phase": "hardening-consolidation-outcome-validation",
  "composition_model": {
    "architecture": "persistent-cognitive-runtime",
    "roles": ["RUNTIME", "PRIMARY", "SUPPORTING", "EXECUTION", "DORMANT"],
    "runtime_always_active": true,
    "specialist_loading": "progressive",
    "explicit_alias_selects_primary_without_disabling_runtime_or_needed_support": true,
    "recompose_on_material_subgoal_change": true
  },
  "clusters": [
    {
      "id": "repo-lifecycle",
      "primary_owner_by_intent": {
        "repository-mechanics": "github",
        "implementation-debug-test": "software-development",
        "independent-product-quality-verification": "quality-engineering",
        "artifact-promotion-rollback": "release-engineering",
        "agent-tool-harness-design": "agent-engineering"
      },
      "rule": "Implementation, independent quality assessment, and release promotion are distinct ownership layers; pair only when another owner contributes a necessary layer."
    },
    {
      "id": "quality-interface-security",
      "primary_owner_by_intent": {
        "ux-ui-direction-audit": "interface-design",
        "verify-user-visible-behavior-accessibility-regression": "quality-engineering",
        "security-threat-policy-adversarial-reasoning": "security-engineering"
      },
      "rule": "Quality Engineering verifies agreed behavior and quality evidence but does not own design direction or security policy."
    },
    {
      "id": "state-continuity",
      "primary_owner_by_intent": {
        "concrete-evidence-linked-archive": "ika",
        "generic-memory-scope-governance": "knowledge-memory",
        "repo-entry-resume-context-map": "project-bootstrap"
      },
      "rule": "Do not duplicate persistent state across owners; live canonical project state outranks all three."
    },
    {
      "id": "data-domain",
      "primary_owner_by_intent": {
        "generic-data-integrity-reconciliation": "data-operations",
        "medicine-store-business-rules": "medicine-store-assistant",
        "patient-report-business-rules": "patient-report-assistant"
      },
      "rule": "Generic mechanics may support domain skills but never override their accepted business rules."
    },
    {
      "id": "interface-implementation",
      "primary_owner_by_intent": {
        "ux-ui-direction-audit": "interface-design",
        "code-implementation-debugging": "software-development",
        "visual-reference-image-continuity": "visual-direction"
      },
      "rule": "Pair design with implementation only when both are actually required; image-production continuity is not UI design."
    },
    {
      "id": "evidence-acquisition",
      "primary_owner_by_intent": {
        "current-fact-research-synthesis": "research",
        "external-skill-discovery-adaptation": "skill-acquisition"
      },
      "rule": "Skill Acquisition is not a general research alias and is phase-gated against default expansion."
    },
    {
      "id": "expression-truth",
      "primary_owner_by_intent": {
        "expression-translation-editorial-quality": "writing-editorial",
        "domain-facts": "domain-owner-or-research"
      },
      "rule": "Editorial polish never becomes factual authority."
    }
  ],
  "routing_principles": [
    "one-coherent-intelligence-with-dynamic-faculties",
    "runtime-always-active-specialists-progressive",
    "select-smallest-sufficient-skill-set",
    "explicit-alias-outranks-generic-overlap",
    "primary-owner-first",
    "pair-only-for-distinct-necessary-layer",
    "implementation-verification-release-are-distinct-layers",
    "execution-surface-selection-is-separate-from-skill-selection",
    "recompose-on-material-subgoal-change",
    "no-new-skill-for-already-owned-intent",
    "needs-evidence-before-merge-or-remove"
  ]
}
